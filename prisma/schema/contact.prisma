model WebContact {
  id        String    @id @default(cuid())
  replyTo   String?
  email     String
  firstName String
  lastName  String
  phone     String?
  subject   String
  message   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  repliedAt DateTime?
  ignoredAt DateTime?
  blockedAt DateTime?

  parent  WebContact?  @relation(name: "replies", fields: [replyTo], references: [id], onDelete: Cascade)
  replies WebContact[] @relation(name: "replies")
  blocked WebBlock?

  @@map("web_contacts")
}

model WebBlock {
  email     String   @id
  reason    String?
  userId    Int?
  sourceId  String?  @unique
  createdAt DateTime @default(now())

  user   User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  source WebContact? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@map("web_blocks")
}
