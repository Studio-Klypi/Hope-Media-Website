model Testimonial {
  id          String    @id @default(cuid())
  processedBy Int?
  firstName   String
  lastName    String
  email       String
  role        String
  company     String
  content     String
  ranking     Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  rejectedAt  DateTime?

  processor User? @relation(fields: [processedBy], references: [id], onDelete: SetNull)

  @@map("testimonials")
}
