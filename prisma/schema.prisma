generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// AUTHENTICATION
model User {
  id        Int       @id @default(autoincrement())
  key       String    @unique @default(cuid())
  firstName String
  lastName  String
  email     String    @unique
  phone     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  otps         OTP[]
  sessions     Session[]
  auditEntries AuditEntry[]
  articles     Article[]
  webBlocks    WebBlock[]

  @@map("users")
}

model OTP {
  id        Int       @id @default(autoincrement())
  userId    Int
  code      String    @db.VarChar(6)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@map("otps")
}

model Session {
  id        Int       @id @default(autoincrement())
  token     String    @unique @default(cuid())
  userId    Int
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// SYSTEM TRACKING
enum EntryType {
  CUSTOM_MESSAGE

  LOGGED_IN
  LOGGED_OUT
  LOGGED_OUT_ALL

  OTP_REQUESTED
  OTP_CONSUMED

  USER_CREATED

  ARTICLE_CREATED
  ARTICLE_UPDATED
  ARTICLE_PUBLISHED
  ARTICLE_UNPUBLISHED
  ARTICLE_ARCHIVED
  ARTICLE_RESTORED
  ARTICLE_DELETED

  WEB_MESSAGE_RECEIVED
  WEB_MESSAGE_REPLYED
  WEB_MESSAGE_IGNORE
  WEB_SENDER_BLOCKED
}

model AuditEntry {
  id        Int       @id @default(autoincrement())
  key       String    @unique @default(cuid())
  type      EntryType @default(CUSTOM_MESSAGE)
  userId    Int?
  data      Json?
  createdAt DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_entries")
}

// BLOG
enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Article {
  id          Int           @id @default(autoincrement())
  authorId    Int?
  slug        String        @unique
  banner      String?
  status      ArticleStatus @default(DRAFT)
  title       String
  content     String        @db.Text()
  excerpt     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  publishedAt DateTime?
  archivedAt  DateTime?

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  articleViews ArticleView[]

  @@map("articles")
}

model ArticleView {
  id        String   @id @default(cuid())
  ip        String
  articleId Int
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@map("article_views")
}

// WEB CONTACT
model WebContact {
  id        String    @id @default(cuid())
  replyTo   String?
  email     String
  firstName String
  lastName  String
  phone     String?
  subject   String
  message   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  repliedAt DateTime?
  ignoredAt DateTime?
  blockedAt DateTime?

  parent  WebContact?  @relation(name: "replies", fields: [replyTo], references: [id], onDelete: Cascade)
  replies WebContact[] @relation(name: "replies")
  blocked WebBlock?

  @@map("web_contacts")
}

model WebBlock {
  email     String   @id
  reason    String?
  userId    Int?
  sourceId  String?  @unique
  createdAt DateTime @default(now())

  user   User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  source WebContact? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@map("web_blocks")
}
