<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-text font-size="14px" line-height="1.6" color="#333333" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#f4f4f4">
    <mj-section background-color="#111111" padding="24px 32px">
      <mj-column>
        <mj-text font-size="20px" font-weight="bold" color="#ffffff">
          Hope Media
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding="32px">
      <mj-column>
        <mj-text font-size="22px" font-weight="bold" color="#111111">
          Réponse à votre message
        </mj-text>

        <mj-text>
          Bonjour {{firstName}},
        </mj-text>

        <mj-text>
          Nous avons répondu à votre message concernant <strong>{{subject}}</strong>.
        </mj-text>

        <mj-divider border-color="#eeeeee" border-width="1px" padding="16px 0" />

        <mj-text font-size="13px" color="#666666" font-weight="bold">
          Notre réponse :
        </mj-text>

        <mj-section padding="0">
          <mj-column background-color="#f4f4f4" border-radius="8px" padding="16px">
            <mj-text font-size="13px" color="#444444">
              {{replyHtml}}
            </mj-text>
          </mj-column>
        </mj-section>

        <mj-divider border-color="#eeeeee" border-width="1px" padding="16px 0" />

        <mj-text font-size="13px" color="#999999" font-weight="bold">
          Votre message initial :
        </mj-text>

        <mj-section padding="0">
          <mj-column border-left="3px solid #dddddd" padding-left="12px">
            <mj-text font-size="13px" color="#888888">
              {{originalMessageHtml}}
            </mj-text>
          </mj-column>
        </mj-section>

        <mj-divider border-color="#eeeeee" border-width="1px" padding="16px 0" />

        <mj-text color="#999999" font-size="12px">
          Cet e-mail est une réponse à votre prise de contact avec Hope Media.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="16px">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#999999">
          © Hope Media — Tous droits réservés
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
