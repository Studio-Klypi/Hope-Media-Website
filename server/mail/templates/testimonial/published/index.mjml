<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-text font-size="14px" line-height="1.6" color="#333333" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#f4f4f4">
    <mj-section background-color="#111111" padding="24px 32px">
      <mj-column>
        <mj-text font-size="20px" font-weight="bold" color="#ffffff">
          Hope Media
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding="32px">
      <mj-column>
        <mj-text font-size="22px" font-weight="bold" color="#111111">
          Votre témoignage est en ligne !
        </mj-text>

        <mj-text>
          Bonjour {{firstName}},
        </mj-text>

        <mj-text>
          Votre témoignage a été examiné et publié sur notre site. Merci encore pour votre confiance et le temps que vous nous avez accordé.
        </mj-text>

        <mj-divider border-color="#eeeeee" border-width="1px" padding="16px 0" />

        <mj-text font-size="13px" color="#666666" font-weight="bold">
          Votre témoignage publié :
        </mj-text>

        <mj-section padding="0">
          <mj-column background-color="#f4f4f4" border-radius="8px" padding="16px">
            <mj-text font-size="13px" color="#444444">
              {{contentHtml}}
            </mj-text>
          </mj-column>
        </mj-section>

        <mj-divider border-color="#eeeeee" border-width="1px" padding="16px 0" />

        <mj-text color="#999999" font-size="12px">
          Si vous souhaitez que votre témoignage soit retiré, contactez-nous à tout moment.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="16px">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#999999">
          © Hope Media — Tous droits réservés
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
